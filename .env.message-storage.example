# WPPConnect Server - Message Storage Configuration Example

# This file shows example configuration for enabling message and chat history storage.
# Copy these settings to your config.ts or set them as environment variables.

# ==========================================
# Message Storage Configuration
# ==========================================

# Enable or disable message storage (default: false)
MESSAGE_STORAGE_ENABLED=false

# MongoDB database name for message storage
MESSAGE_STORAGE_MONGODB_DATABASE=wppconnect_messages

# MongoDB connection details
MESSAGE_STORAGE_MONGODB_HOST=localhost
MESSAGE_STORAGE_MONGODB_PORT=27017

# MongoDB authentication (optional)
MESSAGE_STORAGE_MONGODB_USER=
MESSAGE_STORAGE_MONGODB_PASSWORD=

# Remote MongoDB connection (if using cloud MongoDB like Atlas)
MESSAGE_STORAGE_MONGO_IS_REMOTE=false
MESSAGE_STORAGE_MONGO_URL_REMOTE=

# ==========================================
# Example Remote MongoDB Atlas Configuration
# ==========================================
# If using MongoDB Atlas, set these values:
# MESSAGE_STORAGE_ENABLED=true
# MESSAGE_STORAGE_MONGO_IS_REMOTE=true
# MESSAGE_STORAGE_MONGO_URL_REMOTE=mongodb+srv://username:password@cluster.mongodb.net/wppconnect_messages?retryWrites=true&w=majority

# ==========================================
# Example Local MongoDB Configuration
# ==========================================
# If using local MongoDB, set these values:
# MESSAGE_STORAGE_ENABLED=true
# MESSAGE_STORAGE_MONGODB_HOST=localhost
# MESSAGE_STORAGE_MONGODB_PORT=27017
# MESSAGE_STORAGE_MONGO_IS_REMOTE=false
# MESSAGE_STORAGE_MONGODB_USER=
# MESSAGE_STORAGE_MONGODB_PASSWORD=

# ==========================================
# Notes
# ==========================================
# 
# 1. Make sure mongoose is installed: npm install mongoose
# 2. Ensure MongoDB is running before starting the server
# 3. Message storage is completely optional and disabled by default
# 4. When disabled, no storage operations occur
# 5. See docs/MESSAGE_STORAGE.md for complete documentation
# 6. Use separate database for message storage (not same as token storage)
